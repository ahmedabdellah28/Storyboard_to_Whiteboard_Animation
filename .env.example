# ==============================================================================
# AION Studio V6 — Environment Configuration Template
# Copy this file to `.env` and fill in your real Gemini API keys.
# NEVER commit `.env` to Git!
# ==============================================================================

# Primary Gemini API key (required for TTS voiceover & AI stages)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional additional keys for automatic quota/rate-limit pool rotation
# GEMINI_API_KEY2=your_second_gemini_api_key_here
# GEMINI_API_KEY3=your_third_gemini_api_key_here

# Optional custom project root override (auto-detected if omitted)
# PRODUCTION_PROJECT_ROOT=

# Optional custom paths to standalone EffectCraft / PhotoCraft binaries
# (Auto-detected in `bin/` or `craftApp/*/target/release/` if omitted)
# EFFECTCRAFT_CLI=
# PHOTOCRAFT_CLI=
