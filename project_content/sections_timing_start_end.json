  {
    "section_id": "02_extreme_poverty",
    "section_num": "02",
    "section_name": "الطبقة الثانية: الفقر المدقع (Extreme Poverty)",
    "total_duration": 106.56479166666666,
    "title_phrase": "الطبقة الثانية: الفقر المدقع.",
    "scenes": [
      {
        "element_id": "r1_01_waking_up",
        "start_t": 4.1,
        "end_t": 15.35,
        "duration": 11.25,
        "text": "هنا عندك سقف لكنه بالكاد يعتبر أماناً، ممكن تصحى في غرفة صغيرة مستأجرة بالأسبوع أو شقة زحمة تشاركها مع أكثر من شخص عشان تقسم الإيجار."
      },
      {
        "element_id": "r1_02_crowded_room",
        "start_t": 15.35,
        "end_t": 23.33,
        "duration": 7.98,
        "text": "مرتب على الأرض أحياناً المكيف أو الدفاية خربانة، أول شيء تشيك على جوالك مسبق الدفع هل الخدمة لسه شغالة؟ بعدها تعد تذاكر الباص اللي باقي في محفظتك."
      },
      {
        "element_id": "r1_03_broken_ac",
        "start_t": 23.33,
        "end_t": 33.3,
        "duration": 9.97,
        "text": "وتبدأ تخطط يومك حول الفلوس، الفطور أساسي: شوفان، بيض، توست، مقاضي بسيطة، تستخدم كوبونات وبطاقات التموين ومواعيد الجمعيات الخيرية، كل شيء محسوب، واذا عندك أطفال"
      },
      {
        "element_id": "r1_04_prepaid_phone",
        "start_t": 33.3,
        "end_t": 41.5,
        "duration": 8.2,
        "text": "ممكن يعتمد جزء من أكلهم على وجبات المدرسة وأنت تجهز لهم سناك من البيت لأن كل ريال يفرق، المشوار للدوام ياخد وقت، تنتظر باص يتاخر،"
      },
      {
        "element_id": "r1_05_counting_tickets",
        "start_t": 41.5,
        "end_t": 49.5,
        "duration": 8.0,
        "text": "أو تسوق سيارة متهالكة ولمبة المكينة فيها شغالة وأنت تقول بعدين اصلحها، ساعات دوامك ممكن تتغير كل أسبوع، يوم يطلبونك ويوم ما يطلبونك."
      },
      {
        "element_id": "r2_01_basic_breakfast",
        "start_t": 49.5,
        "end_t": 58.3,
        "duration": 8.8,
        "text": "ولهذا تقول نعم لأي شفت إضافي أو شغل يومي تقدر عليه، ما تقدر تخاطر وتقول لا، الإكراميات والأوفرتايم هنا مو رفاهية، أحياناً هي اللي تخلي الكهرب شغال."
      },
      {
        "element_id": "r2_02_shopping_coupons",
        "start_t": 58.3,
        "end_t": 66.8,
        "duration": 8.5,
        "text": "الفواتير نفسها صارت لغز تحل كل شهر، الإيجار له موعد، الكهرب متاخرة، والفاتورة الثانية تنتظر، تختار أي غرامة توجع أقل، حتى طريقة الدفع تفكر فيها."
      },
      {
        "element_id": "r2_03_kids_snacks",
        "start_t": 66.8,
        "end_t": 77.2,
        "duration": 10.4,
        "text": "تستريح ولا مالياً لأنك تبي تتجنب رسوم البنك، والأوراق ما تخلص، الصحة، موعد عيادة بعد أسابيع أو طوارئ لما الألم يصير أقوى من الانتظار، والتأمين إذا موجود."
      },
      {
        "element_id": "r2_04_waiting_bus",
        "start_t": 77.2,
        "end_t": 86.8,
        "duration": 9.6,
        "text": "ممكن يكون محدود أو عالي التحمل، حتى إصلاح الأسنان يتأجل، لأن عندك أشياء أهم، الغسيل يحتاج فلوس ووقت، فتجمعه مع مشوار المرسلة."
      },
      {
        "element_id": "r2_05_broken_car",
        "start_t": 86.8,
        "end_t": 96.6,
        "duration": 9.8,
        "text": "وتستفيد من الواي فاي المجاني عشان تدور وظايف وتتعلم منوتيوب كيف تصلح أغراضك بشطرطون وصمغ، هنا كل شيء له عمر أطول مما يستحق، الصابون، البنزين، بيانات الجوال."
      },
      {
        "element_id": "r3_01_work_schedule",
        "start_t": 96.6,
        "end_t": 106.56,
        "duration": 9.96,
        "text": "حتى الصبر، وبالليل تشيك جدول بكره، تضبط منبهين وتسوي قائمة بسيطة: اتصال، موعد، جمعية، شغل، وبعدها تنام لأن بكره عندك نفس السباك."
      }
    ]
  },
